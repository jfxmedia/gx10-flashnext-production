# Copy to .env and adjust paths only. Do not commit .env or model artifacts.
NAME=flashnext-autoround-mtp3
IMAGE=gx10-qwen38-flash-next-lab:autoround-mtp3
MODEL_DIR=/srv/flashnext/model
TABLE_DIR=/srv/flashnext/ple-table-fp8
BIND_HOST=127.0.0.1
PORT=8019
SERVED_NAME=qwen3.8-flash-next-autoround
CTX=262144
SEQS=8
BATCHED_TOKENS=8192
GPU_MEM=0.01
KV_BYTES=20g
MTP=3
PREFIX_CACHE=1
PREWARM=0
PLE_PREFETCH=0
PLE_MADV_RANDOM=0
FP8_HYBRID=1
WARMUP=1
WARMUP_SIZES=4096,16384,32768
WARMUP_MAX_TOKENS=128
WARMUP_BATCH_SIZE=2
WARMUP_READY_TIMEOUT=320
VLLM_DISABLE_EAGLE_BLOCK_DROP=0
VLLM_QSA_EXACT_TOPK=0
